#!/usr/bin/env bash
# arch-debian-fym: scolds you for typing Debian-isms (apt, dpkg, service...) on
# Arch and shows the pacman/systemctl equivalent, following the Debian/Ubuntu
# column of https://wiki.archlinux.org/title/Pacman/Rosetta. In an interactive
# terminal it then asks whether to run the suggested command; it never runs
# anything without a "y". Dispatches on the name it was invoked as.

# Everything lives in main() and is invoked on the last line: bash then has the
# whole script in memory before running anything, so editing this file (or a
# git pull) while a prompt is waiting can't corrupt the running copy.
main() {

# --- names: the single source of truth (install.sh reads them via --list-names)
CORE=(apt apt-get apt-cache service)   # always linked by the installer
OTHER=(aptitude apt-mark apt-file apt-cdrom add-apt-repository dpkg dpkg-query dpkg-deb
       dlocate deborphan debsums debi debuild debcheckout lintian)
# "real-name misspelling misspelling ...": the installer links every misspelling too
TYPOS=(
  "apt atp aptt"
  "apt-get atp-get apt-egt atp-egt aptget apt-gte egt apt-gt"
  "apt-cache atp-cache apt-cahce apt-chache apt-cach"
  "service sevrice sevrcie sercvie servcie srevice sevice servise sercive srvice"
)
if [[ ${0##*/} == arch-debian-fym && ${1-} == --list-names ]]; then
  printf 'core %s\n' "${CORE[@]}"
  printf 'extra %s\n' "${OTHER[@]}"
  for line in "${TYPOS[@]}"; do read -ra w <<<"$line"; printf 'extra %s\n' "${w[@]:1}"; done
  exit 0
fi

# ital <text>: a status line in italics (when the terminal supports formatting).
ital() {
  if [[ ${TERM:-dumb} != dumb ]]; then printf '\e[3m%s\e[0m\n' "$1" >&2
  else printf '%s\n' "$1" >&2; fi
}

# First step: if we were started through sudo, drop back to the invoking user.
# We never need root ourselves; the commands we suggest carry their own sudo.
if (( EUID == 0 )) && [[ -n ${SUDO_USER-} && $SUDO_USER != root ]]; then
  if ! command -v runuser >/dev/null; then
    echo "arch-debian-fym: can't drop root (runuser not found)" >&2; exit 1
  fi
  IFS=: read -r _ _ _ _ _ home shell < <(getent passwd "$SUDO_USER")
  if [[ -t 2 ]]; then   # only chatter at a terminal
    n=${shell##*/}; n=${n:-shell}
    ital "root entered the chat"
    sighs=("can't believe you'd run some random script as root smh"
           "really? a random script, as root? bold"
           "you didn't need me for this, you know"
           "wow. just wow. a random script. as root."
           "bold of you to hand a random script the keys to everything"
           "i've seen things, but this is a new low"
           "you could've just run it as yourself, you know")
    printf '<root> %s\n' "${sighs[${SRANDOM:-$RANDOM} % ${#sighs[@]}]}" >&2
    ital "$n kicked root"
  fi
  exec runuser -u "$SUDO_USER" -- env FYM_TOOL="${FYM_TOOL:-${0##*/}}" FYM_WAS_ROOT=1 \
    HOME="$home" USER="$SUDO_USER" LOGNAME="$SUDO_USER" SHELL="${shell:-/bin/sh}" \
    "$(readlink -f "$0")" "$@"
fi

tool=${FYM_TOOL:-${0##*/}}
orig=$tool
# Map a misspelt command name to the real one, and anything unknown to "usage".
for line in "${TYPOS[@]}"; do
  read -ra w <<<"$line"
  if [[ " ${w[*]:1} " == *" $tool "* ]]; then tool=${w[0]}; break; fi
done
[[ " ${CORE[*]} ${OTHER[*]} " == *" $tool "* ]] || tool=usage
fixed=   # the corrected spelling, if the user mistyped something
[[ $tool != usage && $orig != "$tool" ]] && fixed=$tool

q() { local s; s=$(printf '%q ' "$@"); printf '%s' "${s% }"; }  # shell-quote operands

cmd= note= args=none override= sub= act= rest=()
# args: how operands attach to cmd: need (required), opt (optional), none (ignored)

if [[ $tool == service ]]; then
  # service <name> <action> | service --status-all
  svc=
  for a in "$@"; do
    if [[ $a == --status-all ]]; then act=status-all
    elif [[ $a == -* ]]; then :
    elif [[ -z $svc ]]; then svc=$a
    elif [[ -z $act ]]; then act=$a; fi
  done
  act_in=$act
  case $act in   # common action typos
    strat|sart|satrt)         act=start ;;
    restrat|restat|resatrt|retsart) act=restart ;;
    staus|stauts|satus|statsu) act=status ;;
    stpo|sotp)                act=stop ;;
    relaod|realod)            act=reload ;;
  esac
  [[ $act != "$act_in" ]] && fixed="service ${svc:+$svc }$act"
  case $act in
    start|stop|restart|reload|enable|disable)
      cmd="sudo systemctl $act" ;;
    force-reload) cmd="sudo systemctl reload-or-restart" ;;
    condrestart|try-restart) cmd="sudo systemctl try-restart" ;;
    status) cmd="systemctl status" ;;
    status-all)
      cmd="systemctl list-units --type=service"; svc=
      note="add --all to include inactive units." ;;
    "") [[ -n $svc ]] && { cmd="systemctl status"; note="no action given; here's the status. others: start, stop, restart, reload."; } ;;
  esac
  if [[ -n $cmd && -n $svc ]]; then cmd+=" $(printf '%q' "$svc")"
  elif [[ -n $cmd && $act != status-all ]]; then cmd+=" <service>"; fi
  sub=$act

elif [[ $tool != usage ]]; then
  # --- parse ---------------------------------------------------------------
  # First non-option word is the subcommand (for dpkg-style tools the first
  # option is the operation); everything else non-option is an operand.
  flags=() pkgs=() release=
  argv=("$@"); i=0
  while (( i < ${#argv[@]} )); do
    a=${argv[i]}; (( i++ ))
    case $a in
      -t|--target-release) release=${argv[i]-}; (( i++ )); flags+=("$a") ;;
      --target-release=*)  release=${a#*=}; flags+=("$a") ;;
      -o|--option|-c|--config-file)
        if [[ $tool == apt || $tool == apt-get || $tool == apt-cache || $tool == aptitude ]]; then (( i++ )); fi
        flags+=("$a") ;;
      -*) flags+=("$a") ;;
      *)  case $tool in   # tools with a subcommand word; the rest take only operands
            apt|apt-get|apt-cache|aptitude|apt-mark|apt-file|apt-cdrom)
              if [[ -z $sub ]]; then sub=$a; else pkgs+=("$a"); fi ;;
            *) pkgs+=("$a") ;;
          esac ;;
    esac
  done
  [[ $tool == dpkg* ]] && sub=${flags[0]-}
  sub_in=$sub
  case $sub in   # common subcommand typos
    isntall|instal|intall|insatll|isntal|instll|nstall) sub=install ;;
    updaet|udpate|upate|updte|uptade)                   sub=update ;;
    upgrde|ugprade|upgarde|upgrad|ugrade)               sub=upgrade ;;
    remvoe|romove|remov|reomve|rmeove)                  sub=remove ;;
    serach|saerch|seach|searhc)                         sub=search ;;
    autoremvoe|autoremov|autoreomve)                    sub=autoremove ;;
  esac
  [[ $sub != "$sub_in" ]] && fixed="$tool $sub"
  rest=("${pkgs[@]}")

  short_has() { local f; for f in "${flags[@]}"; do [[ $f == -[!-]* && $f == *$1* ]] && return 0; done; return 1; }
  long_has()  { local f; for f in "${flags[@]}"; do [[ $f == "$1" ]] && return 0; done; return 1; }
  yes= simulate= download= fixbroken= purgeflag= installed= upgradable=
  case $tool in apt|apt-get|aptitude)
    { short_has y || long_has --yes || long_has --assume-yes; } && yes=1
    { short_has s || long_has --simulate || long_has --dry-run || long_has --just-print || long_has --recon || long_has --no-act; } && simulate=1
    ;;
  esac
  { short_has d || long_has --download-only; } && download=1
  { short_has f || long_has --fix-broken; } && fixbroken=1
  long_has --purge && purgeflag=1
  long_has --installed && installed=1
  long_has --upgradable && upgradable=1

  refresh_note="arch has no separate 'update': refreshing the database without upgrading (-Sy) is unsupported and can break your system."
  files_note="needs the file database: run 'sudo pacman -Fy' first."

  # --- translate -----------------------------------------------------------
  case $tool in
    apt|apt-get|apt-cache|aptitude)
      # aptitude search patterns
      if [[ $tool == aptitude && $sub == search ]]; then
        case ${pkgs[0]-} in
          '~o'*) cmd="pacman -Qm" ;;
          '~i'*) cmd="pacman -Qs"; args=need ;;
          '~N'*) : ;;
          '~D'*) cmd="pacman -Sii"; args=need ;;
          '~C'*) cmd="pacman -Si"; args=need ;;
          *)     cmd="pacman -Ss"; args=need ;;
        esac
      elif [[ $tool == aptitude && $sub == purge && ${pkgs[0]-} == '~o' ]]; then
        cmd='pacman -Qmq | sudo pacman -Rs -'
      else
        case $sub in
          update)
            cmd="sudo pacman -Syu"; note=$refresh_note ;;
          upgrade|full-upgrade|dist-upgrade|safe-upgrade)
            cmd="sudo pacman -Syu" ;;
          install|reinstall)
            if [[ -n $fixbroken && ${#pkgs[@]} -eq 0 ]]; then
              cmd="pacman -Dk"
              note="that checks pacman's dependency level; for broken shared libraries try lddd (devtools) or findbrokenpkgs (AUR)."
            else
              if [[ -n $download ]]; then cmd="sudo pacman -Sw"; else cmd="sudo pacman -S"; fi
              args=need
              # pkg/release or -t release -> repo/pkg
              for j in "${!rest[@]}"; do
                p=${rest[j]}
                if [[ $p == */* ]]; then rest[j]="${p#*/}/${p%%/*}"
                elif [[ -n $release ]]; then rest[j]="$release/$p"; fi
              done
              if [[ -n $release || "${pkgs[*]}" == */* ]]; then
                note="to pull from a specific repo use repo_name/package, with the repo name (core, extra...) instead of a release name."
              fi
            fi ;;
          remove)
            if [[ -n $purgeflag ]]; then cmd="sudo pacman -Rn"; else cmd="sudo pacman -R"; fi
            args=need ;;
          purge)
            cmd="sudo pacman -Rn"; args=need ;;
          autoremove|autopurge)
            p=-Rs; { [[ -n $purgeflag || $sub == autopurge ]]; } && p=-Rns
            if (( ${#pkgs[@]} )); then cmd="sudo pacman $p"; args=need
            else
              cmd="pacman -Qdtq | sudo pacman $p -"
              note="removes orphaned dependencies. use -Qdttq to include optional deps too."
            fi ;;
          search)
            cmd="pacman -Ss"; args=need ;;
          show|info|showpkg|depends)
            cmd="pacman -Si"; args=need
            note="use 'pacman -Qi' instead for packages that are already installed." ;;
          rdepends|why)
            cmd="pacman -Sii"; args=need
            note="use 'pacman -Qii' for installed packages." ;;
          policy)
            if (( ${#pkgs[@]} )); then cmd="pacman -Si"; args=need
            else cmd="cat /etc/pacman.d/mirrorlist"; fi ;;
          list)
            if [[ -n $installed ]]; then
              cmd="pacman -Q"; note="pacman -Qm lists installed packages that are in no repository."
            elif [[ -n $upgradable ]]; then cmd="pacman -Qu"
            else cmd="pacman -Sl"; fi ;;
          dumpavail|dump|pkgnames)
            cmd="pacman -Sl" ;;
          stats)
            cmd="ls /var/lib/pacman/local" ;;
          dotty)
            cmd="pactree --graph"; args=need; note="pactree comes from pacman-contrib." ;;
          changelog)
            cmd="pacman -Qc"; args=need ;;
          clean)
            cmd="sudo pacman -Scc" ;;
          autoclean)
            cmd="sudo pacman -Sc" ;;
          edit-sources)
            cmd="sudoedit /etc/pacman.conf" ;;
          download)
            cmd="sudo pacman -Sw"; args=need ;;
          check)
            cmd="pacman -Dk" ;;
          source)
            cmd="asp export"; args=need
            note="asp is the ABS tool; then run 'makepkg -o' in the checked-out directory to fetch the sources." ;;
          build-dep)
            cmd="makepkg -seoc"
            note="run it inside the package's PKGBUILD directory (get it via ABS/asp)." ;;
          add)
            if [[ $tool == apt-cache ]]; then
              (( ${#pkgs[@]} )) && override="sudo cp $(q "${pkgs[@]}") /var/cache/pacman/pkg/"
            fi ;;
        esac
      fi
      # transaction modifiers from apt's flags
      if [[ $cmd == "sudo pacman "* && $cmd != *'|'* ]]; then
        [[ -n $simulate ]] && { cmd=${cmd#sudo }; cmd+=" -p"; }
        [[ -n $yes ]] && cmd+=" --noconfirm"
      fi ;;

    apt-mark)
      case $sub in
        manual)   cmd="sudo pacman -D --asexplicit"; args=need ;;
        auto)     cmd="sudo pacman -D --asdeps"; args=need
                  note="to install something as a dependency in the first place: pacman -S --asdeps." ;;
        hold)     cmd="sudoedit /etc/pacman.conf"; note="add ${pkgs[*]:-the package} to the IgnorePkg array." ;;
        unhold)   cmd="sudoedit /etc/pacman.conf"; note="remove ${pkgs[*]:-the package} from the IgnorePkg array." ;;
        showhold) cmd="grep -E 'IgnorePkg|HoldPkg' /etc/pacman.conf" ;;
        showmanual) cmd="pacman -Qe" ;;
        showauto)   cmd="pacman -Qd" ;;
      esac ;;

    apt-file)
      case $sub in
        search) cmd="pacman -F"; args=need; note=$files_note ;;
        list|show) cmd="pacman -Fl"; args=need; note=$files_note ;;
        update) cmd="sudo pacman -Fy" ;;
      esac ;;

    apt-cdrom|add-apt-repository)
      cmd="sudoedit /etc/pacman.conf"
      note="installation sources live in /etc/pacman.conf (add a [repo] section, or use the AUR for PPA-style software)." ;;

    dpkg|dpkg-query|dpkg-deb)
      case $sub in
        -i|--install)          cmd="sudo pacman -U"; args=need ;;
        -r|--remove)           cmd="sudo pacman -R"; args=need ;;
        -P|--purge)            cmd="sudo pacman -Rn"; args=need ;;
        -l|--list|-W|--show)   cmd="pacman -Q"; args=opt ;;
        -L|--listfiles)        cmd="pacman -Ql"; args=need ;;
        -s|--status)           cmd="pacman -Qi"; args=need ;;
        -S|--search)           cmd="pacman -Qo"; args=need ;;
        -I|--info)             cmd="pacman -Qp"; args=need ;;
        -c|--contents)         cmd="pacman -Qpl"; args=need ;;
        -C|--audit)            cmd="pacman -Dk" ;;
        -V|--verify)           cmd="pacman -Qk"; args=opt ;;
        -x|--extract|--fsys-tarfile)
          if   (( ${#pkgs[@]} >= 2 )); then override="tar -xvf $(q "${pkgs[0]}") -C $(q "${pkgs[1]}")"
          elif (( ${#pkgs[@]} == 1 )); then override="tar -xvf $(q "${pkgs[0]}")"
          else cmd="tar -xvf"; args=need; fi ;;
      esac ;;

    dlocate)   cmd="pacman -Qo"; args=need ;;
    deborphan) cmd="pacman -Qtt" ;;
    debsums)   cmd="pacman -Qk"; args=opt; note="add another k (-Qkk) for a deeper check." ;;
    debi)      cmd="sudo pacman -U"; args=need ;;
    debuild)   cmd="makepkg -s"; note="run it in the directory containing the PKGBUILD." ;;
    lintian)   cmd="namcap"; args=need; note="namcap needs to be installed (pacman -S namcap)." ;;
    debcheckout)
               cmd="asp export"; args=need
               note="asp is the ABS tool; then run 'makepkg -o' in the checked-out directory to fetch the sources." ;;
  esac
fi

# --- chat-style output -------------------------------------------------------
# Messages look like IRC lines from your own shell: "<fish> this is arch, btw."
# When not on an interactive terminal, only the command is printed (to stdout).
nick=${SHELL##*/}; nick=${nick:-shell}

# say <text>: print one chat line.
say() { printf '<%s> %s\n' "$nick" "$1" >&2; }

# sudo is about to run: the shell grudgingly lets it in, root gloats.
sudo_reenters() {
  local grudges=("ugh fine" "you asked for it" "its your funeral" "why am I even trying" "your call")
  local gloats=("guess who's back, back again" "look who came crawling back")
  say "${grudges[${SRANDOM:-$RANDOM} % ${#grudges[@]}]}"
  ital "$nick invited root to this chat"
  printf '<root> %s\n' "${gloats[${SRANDOM:-$RANDOM} % ${#gloats[@]}]}" >&2
}

# Say what is being run (in italics), run the suggested command and pass its status on.
# For a sudo command: if we were started as root, root gloats about coming back
# and then root takes over again; otherwise root takes over. Whoever takes over gets
# the credit for running it (with the "sudo " stripped from the command).
run_it() {
  local who=$nick shown=$final rc
  if [[ $final == "sudo "* ]]; then
    if [[ -n ${FYM_WAS_ROOT-} ]]; then
      sudo_reenters
      printf "<root> i'll take it from here\n" >&2
      who=root shown=${final#sudo }
    else
      printf "<root> i'll take it from here\n" >&2
      who=root shown=${final#sudo }
    fi
  fi
  ital "$who ran $shown"
  bash -c "$final"
  exit $?
}

# The command to suggest, when we have a complete one.
final=$override
if [[ -z $final && -n $cmd ]]; then
  case $args in
    need) (( ${#rest[@]} )) && final="$cmd $(q "${rest[@]}")" ;;
    opt)  final=$cmd; (( ${#rest[@]} )) && final+=" $(q "${rest[@]}")" ;;
    *)    final=$cmd ;;
  esac
fi

# Not an interactive terminal (piped, captured, cron...): print only the command.
if [[ ! ( -t 1 && -t 2 ) ]]; then
  if [[ -n $final ]]; then printf '%s\n' "$final"
  else echo "arch-debian-fym: no command to suggest for: ${tool}${*:+ $*}" >&2; fi
  exit 1
fi

if [[ -n $final ]]; then
  say "this is arch, btw. run this instead:"
  say "$final"
  [[ -n $note ]] && say "$note"
  if [[ -n $fixed ]]; then
    guesses=("don't you mean %s" "i think you meant %s" "that should have been %s imo"
             "you sure you didn't mean %s")
    # shellcheck disable=SC2059
    say "$(printf "${guesses[${SRANDOM:-$RANDOM} % ${#guesses[@]}]}" "$fixed")"
  fi
  me=${USER:-$(id -un)}
  if [[ -n ${FYM_NO_PROMPT-} ]]; then
    # Prompt disabled: just do it.
    yolo_words=("fuck it we ball" "jesus take the wheel" "yeah whatever just do it"
                "couldn't care less" "ok whatever" "leeeroy jenkins" "fire in the hole"
                "i like to live dangerously" "yeah yeah sure" "yeah sure" "ok" "idgaf"
                "of course" "what could possibly go wrong")
    printf '<%s> %s\n' "$me" "${yolo_words[${SRANDOM:-$RANDOM} % ${#yolo_words[@]}]}" >&2
    run_it
  # Otherwise offer to run it, only when we're talking to a real person.
  elif [[ -t 0 ]]; then
    say "fym, y/n?"
    # Read one key with signal generation off, so Ctrl+C arrives as a plain key
    # (anything but y counts as "no") and the terminal is always put back.
    ans=
    printf '<%s> ' "$me" >&2             # your "chat input" line, shown while waiting
    tty_state=$(stty -g 2>/dev/null)
    [[ -n $tty_state ]] && trap 'stty "$tty_state" 2>/dev/null' EXIT
    # (bash's own `read -n` turns signal generation back on, so read via dd.)
    stty -isig -icanon -echo min 1 2>/dev/null
    ans=$(dd bs=1 count=1 2>/dev/null) || ans=n
    # Keys like Esc/arrows send several bytes at once: swallow the rest of what
    # is already buffered (no waiting) so it doesn't leak into your shell.
    while read -t 0 2>/dev/null; do dd bs=1 count=1 of=/dev/null 2>/dev/null || break; done
    [[ -n $tty_state ]] && stty "$tty_state" 2>/dev/null
    yes_words=(yes yeah yure ye "y not" yus yup)
    no_words=(nvm nope nah "no ty" "no thanks" nevermind)
    if [[ $ans == [yY] ]]; then
      printf '%s\n' "${yes_words[${SRANDOM:-$RANDOM} % ${#yes_words[@]}]}" >&2
        run_it
    fi
    printf '%s\n' "${no_words[${SRANDOM:-$RANDOM} % ${#no_words[@]}]}" >&2
  fi
elif [[ -n $cmd ]]; then
  say "this is arch, btw. run this instead (with your package names):"
  say "$cmd <package>..."
elif [[ $tool == usage ]]; then
  say "this is arch, btw. run me as apt, apt-get, dpkg, service... (that's what the installer sets up)."
elif [[ -z $sub ]]; then
  if [[ $tool == service ]]; then
    say "this is arch, btw. you didn't even say what you wanted. services are systemd:"
    say "sudo systemctl restart <service>"
    say "systemctl status <service>"
  else
    say "this is arch, btw. you didn't even say what you wanted. package management is pacman:"
    say "sudo pacman -Syu        upgrade everything"
    say "sudo pacman -S <pkg>    install"
    say "sudo pacman -Rns <pkg>  remove"
    say "pacman -Ss <term>       search"
  fi
elif [[ $tool == service ]]; then
  say "this is arch, btw. i don't have a translation for '${act}'. try man systemctl."
else
  say "this is arch, btw. i don't have a translation for '${sub}'. try man pacman or the arch wiki:"
  say "https://wiki.archlinux.org/title/Pacman/Rosetta"
fi

exit 1
}

main "$@"; exit $?
