#!/usr/bin/env bash
# arch-debian-fym: scolds you for typing Debian-isms (apt, service) on Arch and
# shows the pacman/systemctl equivalent. In an interactive terminal it then asks
# whether to run the suggested command; it never runs anything without a "y".
# Dispatches on the name it was invoked as (apt, apt-get, apt-cache, service).

tool=${0##*/}
case $tool in apt|apt-get|apt-cache|service) ;; *) tool=usage ;; esac

if [[ $tool == service ]]; then
  # service <name> <action> | service --status-all
  svc= act= sub=service
  for a in "$@"; do
    if [[ $a == --status-all ]]; then act=status-all
    elif [[ $a == -* ]]; then :
    elif [[ -z $svc ]]; then svc=$a
    elif [[ -z $act ]]; then act=$a; fi
  done
  cmd= note= need_pkgs=
  rest=()
  case $act in
    start|stop|restart|reload|enable|disable)
      cmd="sudo systemctl $act" ;;
    force-reload) cmd="sudo systemctl reload-or-restart" ;;
    condrestart|try-restart) cmd="sudo systemctl try-restart" ;;
    status) cmd="systemctl status" ;;
    status-all)
      cmd="systemctl list-units --type=service"; svc=
      note="add --all to include inactive units." ;;
    "") [[ -n $svc ]] && { cmd="systemctl status"; note="no action given; here's the status. others: start, stop, restart, reload."; } ;;
  esac
  if [[ -n $cmd && -n $svc ]]; then cmd+=" $(printf '%q' "$svc")"
  elif [[ -n $cmd && $act != status-all ]]; then cmd+=" <service>"; fi
  sub=$act
else

# Parse: first non-option word is the subcommand, the rest are operands.
sub= flags=() pkgs=() rest=()
for a in "$@"; do
  if [[ -z $sub && $a != -* ]]; then sub=$a
  elif [[ $a == -* ]]; then flags+=("$a")
  else pkgs+=("$a"); fi
done
rest=("${pkgs[@]}")

# `apt list --installed` etc. are decided by flags.
has_flag() { local f; for f in "${flags[@]}"; do [[ $f == "$1" ]] && return 0; done; return 1; }

q() { local s; s=$(printf '%q ' "$@"); printf '%s' "${s% }"; }  # shell-quote operands
cmd= note= need_pkgs=

case $tool:$sub in
  *:update)
    cmd="sudo pacman -Syu"
    note="arch has no separate 'update': refreshing the database without upgrading (-Sy) is unsupported and can break your system." ;;
  *:upgrade|*:full-upgrade|*:dist-upgrade)
    cmd="sudo pacman -Syu" ;;
  *:install|*:reinstall)
    cmd="sudo pacman -S"; need_pkgs=1 ;;
  *:remove)
    cmd="sudo pacman -R"; need_pkgs=1 ;;
  *:purge)
    cmd="sudo pacman -Rns"; need_pkgs=1 ;;
  *:autoremove|*:autopurge)
    cmd='sudo pacman -Rns $(pacman -Qdtq)'
    note="removes orphaned dependencies. If pacman -Qdtq prints nothing, there is nothing to remove." ;;
  *:search|apt-cache:search)
    cmd="pacman -Ss"; need_pkgs=1 ;;
  *:show|*:info|*:policy|*:depends|*:showpkg)
    cmd="pacman -Si"; need_pkgs=1
    note="use 'pacman -Qi' instead for packages that are already installed." ;;
  *:list)
    if has_flag --installed; then cmd="pacman -Q"
    elif has_flag --upgradable; then cmd="pacman -Qu"
    else cmd="pacman -Sl"; fi ;;
  *:clean|*:autoclean)
    cmd="sudo pacman -Sc" ;;
  *:edit-sources)
    cmd='sudoedit /etc/pacman.conf' ;;
  *:download)
    cmd="sudo pacman -Sw"; need_pkgs=1 ;;
  *:source|*:build-dep)
    cmd="asp export <package> && makepkg -s"
    note="needs 'devtools'/'asp'. for AUR packages, just clone the PKGBUILD." ;;
esac

fi

# --- chat-style output -------------------------------------------------------
# Messages look like IRC lines from your own shell: "<fish> this is arch, btw."
# On a terminal each message is typed out character by character (skipped when
# FYM_NO_DELAY is set). When not on an interactive terminal, only the command is
# printed (to stdout).
nick=${SHELL##*/}; nick=${nick:-shell}

animate=
[[ -t 2 && -z ${FYM_NO_DELAY-} ]] && animate=1

# say <text>: type the message out character by character (if on a tty).
say() {
  if [[ -z $animate ]]; then raw "$1"; return; fi
  local text=$1 i
  sleep 0.1
  printf '<%s> ' "$nick" >&2
  for (( i = 0; i < ${#text}; i++ )); do
    printf '%s' "${text:i:1}" >&2
    sleep "0.00$(( RANDOM % 5 + 5 ))"          # 5-9ms per character
  done
  printf '\n' >&2
}
# raw <text>: print a message instantly, no typing (used when not animating).
raw() { printf '<%s> %s\n' "$nick" "$1" >&2; }

# The command to suggest, when we have a complete one.
final=
if [[ -n $cmd ]]; then
  if [[ -z $need_pkgs ]]; then final=$cmd
  elif [[ ${#rest[@]} -gt 0 ]]; then final="$cmd $(q "${rest[@]}")"; fi
fi

# Not an interactive terminal (piped, captured, cron...): print only the command.
if [[ ! ( -t 1 && -t 2 ) ]]; then
  if [[ -n $final ]]; then printf '%s\n' "$final"
  else echo "arch-debian-fym: no command to suggest for: ${tool}${*:+ $*}" >&2; fi
  exit 1
fi

if [[ -n $final ]]; then
  say "this is arch, btw. run this instead:"
  say "$final"
  [[ -n $note ]] && say "$note"
  # Offer to run it, only when we're talking to a real person at a terminal.
  if [[ -t 0 && -z ${FYM_NO_PROMPT-} ]]; then
    say "run it? [y/N]"
    # Read one key with signal generation off, so Ctrl+C arrives as a plain key
    # (anything but y counts as "no") and the terminal is always put back.
    ans=
    me=${USER:-$(id -un)}
    printf '<%s> ' "$me" >&2             # your "chat input" line, shown while waiting
    tty_state=$(stty -g 2>/dev/null)
    [[ -n $tty_state ]] && trap 'stty "$tty_state" 2>/dev/null' EXIT
    # (bash's own `read -n` turns signal generation back on, so read via dd.)
    stty -isig -icanon -echo min 1 2>/dev/null
    ans=$(dd bs=1 count=1 2>/dev/null) || ans=n
    [[ -n $tty_state ]] && stty "$tty_state" 2>/dev/null
    yes_words=(yes yeah yure ye "y not" yus yup)
    no_words=(nvm nope nah "no ty" "no thanks" nevermind)
    if [[ $ans == [yY] ]]; then
      printf '%s\n' "${yes_words[RANDOM % ${#yes_words[@]}]}" >&2
      bash -c "$final"; exit $?
    fi
    printf '%s\n' "${no_words[RANDOM % ${#no_words[@]}]}" >&2
  fi
elif [[ -n $cmd ]]; then
  say "this is arch, btw. run this instead (with your package names):"
  say "$cmd <package>..."
elif [[ $tool == usage ]]; then
  say "this is arch, btw. run me as apt, apt-get, apt-cache or service (that's what the installer sets up)."
elif [[ -z $sub ]]; then
  if [[ $tool == service ]]; then
    say "this is arch, btw. you didn't even say what you wanted. services are systemd:"
    say "sudo systemctl restart <service>"
    say "systemctl status <service>"
  else
    say "this is arch, btw. you didn't even say what you wanted. package management is pacman:"
    say "sudo pacman -Syu        upgrade everything"
    say "sudo pacman -S <pkg>    install"
    say "sudo pacman -Rns <pkg>  remove"
    say "pacman -Ss <term>       search"
  fi
elif [[ $tool == service ]]; then
  say "this is arch, btw. i don't have a translation for '${act}'. try man systemctl."
else
  say "this is arch, btw. i don't have a translation for '${sub}'. try man pacman or the arch wiki:"
  say "https://wiki.archlinux.org/title/Pacman/Rosetta"
fi

exit 1
