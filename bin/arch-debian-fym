#!/usr/bin/env bash
# arch-debian-fym: scolds you for typing Debian-isms (apt, service) on Arch and
# shows the pacman/systemctl equivalent. It never runs anything.
# Dispatches on the name it was invoked as (apt, apt-get, apt-cache, service).

tool=${0##*/}
case $tool in apt|apt-get|apt-cache|service) ;; *) tool=usage ;; esac

if [[ -t 2 && -z ${NO_COLOR-} ]]; then
  B=$'\e[1m' R=$'\e[1;31m' G=$'\e[1;32m' D=$'\e[2m' Z=$'\e[0m'
else
  B= R= G= D= Z=
fi

if [[ $tool == service ]]; then
  # service <name> <action> | service --status-all
  svc= act= sub=service
  for a in "$@"; do
    if [[ $a == --status-all ]]; then act=status-all
    elif [[ $a == -* ]]; then :
    elif [[ -z $svc ]]; then svc=$a
    elif [[ -z $act ]]; then act=$a; fi
  done
  cmd= note= need_pkgs=
  rest=()
  case $act in
    start|stop|restart|reload|enable|disable)
      cmd="sudo systemctl $act" ;;
    force-reload) cmd="sudo systemctl reload-or-restart" ;;
    condrestart|try-restart) cmd="sudo systemctl try-restart" ;;
    status) cmd="systemctl status" ;;
    status-all)
      cmd="systemctl list-units --type=service"; svc=
      note="add --all to include inactive units." ;;
    "") [[ -n $svc ]] && { cmd="systemctl status"; note="no action given; here's the status. others: start, stop, restart, reload."; } ;;
  esac
  if [[ -n $cmd && -n $svc ]]; then cmd+=" $(printf '%q' "$svc")"
  elif [[ -n $cmd && $act != status-all ]]; then cmd+=" <service>"; fi
  sub=$act
else

# Parse: first non-option word is the subcommand, the rest are operands.
sub= flags=() pkgs=() rest=()
for a in "$@"; do
  if [[ -z $sub && $a != -* ]]; then sub=$a
  elif [[ $a == -* ]]; then flags+=("$a")
  else pkgs+=("$a"); fi
done
rest=("${pkgs[@]}")

# `apt list --installed` etc. are decided by flags.
has_flag() { local f; for f in "${flags[@]}"; do [[ $f == "$1" ]] && return 0; done; return 1; }

q() { local s; s=$(printf '%q ' "$@"); printf '%s' "${s% }"; }  # shell-quote operands
cmd= note= need_pkgs=

case $tool:$sub in
  *:update)
    cmd="sudo pacman -Syu"
    note="arch has no separate 'update': refreshing the database without upgrading (-Sy) is unsupported and can break your system." ;;
  *:upgrade|*:full-upgrade|*:dist-upgrade)
    cmd="sudo pacman -Syu" ;;
  *:install|*:reinstall)
    cmd="sudo pacman -S"; need_pkgs=1 ;;
  *:remove)
    cmd="sudo pacman -R"; need_pkgs=1 ;;
  *:purge)
    cmd="sudo pacman -Rns"; need_pkgs=1 ;;
  *:autoremove|*:autopurge)
    cmd='sudo pacman -Rns $(pacman -Qdtq)'
    note="removes orphaned dependencies. If pacman -Qdtq prints nothing, there is nothing to remove." ;;
  *:search|apt-cache:search)
    cmd="pacman -Ss"; need_pkgs=1 ;;
  *:show|*:info|*:policy|*:depends|*:showpkg)
    cmd="pacman -Si"; need_pkgs=1
    note="use 'pacman -Qi' instead for packages that are already installed." ;;
  *:list)
    if has_flag --installed; then cmd="pacman -Q"
    elif has_flag --upgradable; then cmd="pacman -Qu"
    else cmd="pacman -Sl"; fi ;;
  *:clean|*:autoclean)
    cmd="sudo pacman -Sc" ;;
  *:edit-sources)
    cmd='sudoedit /etc/pacman.conf' ;;
  *:download)
    cmd="sudo pacman -Sw"; need_pkgs=1 ;;
  *:source|*:build-dep)
    cmd="asp export <package> && makepkg -s"
    note="needs 'devtools'/'asp'. for AUR packages, just clone the PKGBUILD." ;;
esac

fi

# --- chat-style output -------------------------------------------------------
# Messages look like IRC lines from your own shell: "<fish> this is arch, btw."
# On a terminal each message is preceded by a short "fish is typing..." animation.
# Skipped when stderr isn't a tty or FYM_NO_DELAY is set.
nick=${SHELL##*/}; nick=${nick:-shell}

animate=
[[ -t 2 && -z ${FYM_NO_DELAY-} ]] && animate=1

if [[ -n $animate ]]; then
  printf '\e[?25l' >&2                       # hide cursor while "typing"
  trap 'printf "\e[?25h" >&2' EXIT
  trap 'exit 130' INT TERM
fi

# say <text>: typing animation (if on a tty), then the message.
say() {
  if [[ -n $animate ]]; then
    local frames=$(( 2 + ${#1} / 30 )) i
    (( frames > 5 )) && frames=5
    for (( i = 0; i < frames * 3; i++ )); do
      printf '\r\e[K%s%s is typing%s%s' "$D" "$nick" "$(printf '%*s' $(( i % 3 + 1 )) '' | tr ' ' .)" "$Z" >&2
      sleep 0.15
    done
    printf '\r\e[K' >&2
  fi
  raw "$1"
}
# raw <text>: a message that appears instantly (pasted lines, like commands).
raw() { printf '%s<%s>%s %s\n' "$D" "$nick" "$Z" "$1" >&2; }

say "${R}this is arch, btw.${Z}"

if [[ $tool == usage ]]; then
  say "run me as ${G}apt${Z}, ${G}apt-get${Z}, ${G}apt-cache${Z} or ${G}service${Z} (that's what the installer sets up)."
elif [[ -n $cmd ]]; then
  if [[ -n $need_pkgs && ${#rest[@]} -eq 0 ]]; then
    say "run this instead (with your package names):"
    raw "    ${G}${cmd} <package>...${Z}"
  elif [[ -n $need_pkgs ]]; then
    say "run this instead:"
    raw "    ${G}${cmd} $(q "${rest[@]}")${Z}"
  else
    say "run this instead:"
    raw "    ${G}${cmd}${Z}"
  fi
  [[ -n $note ]] && say "$note"
elif [[ -z $sub ]]; then
  if [[ $tool == service ]]; then
    say "you didn't even say what you wanted. services on arch are ${G}systemd${Z}:"
    raw "    ${G}sudo systemctl restart <service>${Z}"
    raw "    ${G}systemctl status <service>${Z}"
  else
    say "you didn't even say what you wanted. package management on arch is ${G}pacman${Z}:"
    raw "    ${G}sudo pacman -Syu${Z}        upgrade everything"
    raw "    ${G}sudo pacman -S <pkg>${Z}    install"
    raw "    ${G}sudo pacman -Rns <pkg>${Z}  remove"
    raw "    ${G}pacman -Ss <term>${Z}       search"
  fi
else
  if [[ $tool == service ]]; then
    say "i don't have a translation for '${act}'. try ${G}man systemctl${Z}."
  else
    say "i don't have a translation for '${sub}'. try ${G}man pacman${Z} or the arch wiki:"
    raw "    https://wiki.archlinux.org/title/Pacman/Rosetta"
  fi
fi
say "nothing was run. this is arch-debian-fym, not debian."

exit 1
